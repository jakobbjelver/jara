{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JARA Portal Action",
  "description": "Schema for a single action definition in actions.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique action identifier used in routes"
    },
    "name": {
      "type": "string",
      "description": "Human-readable action name shown in the Portal UI"
    },
    "description": {
      "type": "string",
      "description": "Short summary of what the action does"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "color": {
      "type": "string",
      "description": "Optional theme color hint"
    },
    "confirmMessage": {
      "type": "string",
      "description": "Confirmation prompt shown before execution"
    },
    "commands": {
      "type": "array",
      "description": "Ordered list of shell commands to execute",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Human label for this step"
          },
          "command": {
            "type": "string",
            "description": "Shell command to run"
          },
          "run_on": {
            "type": "string",
            "enum": ["host", "container"],
            "description": "Where to run: 'host' runs directly on macOS via SSH, 'container' (default) runs inside code-server"
          }
        },
        "required": ["description", "command"]
      }
    }
  },
  "required": ["id", "name", "description"]
}
